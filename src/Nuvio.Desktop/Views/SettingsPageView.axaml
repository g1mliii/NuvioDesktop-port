<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Nuvio.Desktop.ViewModels"
             x:Class="Nuvio.Desktop.Views.SettingsPageView"
             x:DataType="vm:SettingsPageViewModel">
    <ScrollViewer Padding="26,22">
        <StackPanel Spacing="22" MaxWidth="760">
            <Grid ColumnDefinitions="*,Auto">
                <StackPanel Spacing="4">
                    <TextBlock Text="Settings" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="28" FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding StatusMessage}" Foreground="{DynamicResource TextMutedBrush}" FontSize="13" TextWrapping="Wrap"/>
                </StackPanel>
                <Button Grid.Column="1"
                        Content="Save"
                        Command="{Binding SaveCommand}"
                        AutomationProperties.Name="Save settings"
                        TabIndex="0"
                        Padding="16,8"
                        CornerRadius="5"
                        VerticalAlignment="Center"/>
            </Grid>

            <Grid RowDefinitions="Auto,Auto,Auto,Auto" ColumnDefinitions="220,*" RowSpacing="14" ColumnSpacing="22">
                <TextBlock Text="Theme" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="14" VerticalAlignment="Center"/>
                <ComboBox x:Name="ThemeModeCombo"
                          Grid.Column="1"
                          ItemsSource="{Binding ThemeOptions}"
                          SelectedItem="{Binding SelectedTheme, Mode=TwoWay}"
                          AutomationProperties.Name="Theme mode"
                          TabIndex="1"
                          MinWidth="220">
                    <ComboBox.ItemTemplate>
                        <DataTemplate x:DataType="vm:ThemeModeOption">
                            <TextBlock Text="{Binding Label}"/>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>

                <TextBlock Grid.Row="1" Text="Player" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="14" VerticalAlignment="Center"/>
                <ComboBox x:Name="PlayerModeCombo"
                          Grid.Row="1"
                          Grid.Column="1"
                          ItemsSource="{Binding PlayerModeOptions}"
                          SelectedItem="{Binding SelectedPlayerMode, Mode=TwoWay}"
                          AutomationProperties.Name="Player mode"
                          TabIndex="2"
                          MinWidth="220">
                    <ComboBox.ItemTemplate>
                        <DataTemplate x:DataType="vm:PlayerModeOption">
                            <TextBlock Text="{Binding Label}"/>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>

                <TextBlock Grid.Row="2" Text="Hardware decoding" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="14" VerticalAlignment="Center"/>
                <CheckBox x:Name="HardwareDecodingToggle"
                          Grid.Row="2"
                          Grid.Column="1"
                          IsChecked="{Binding HardwareDecodingEnabled, Mode=TwoWay}"
                          AutomationProperties.Name="Hardware decoding enabled"
                          TabIndex="3"
                          Content="Enabled"/>

                <TextBlock Grid.Row="3" Text="TV focus mode" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="14" VerticalAlignment="Center"/>
                <CheckBox x:Name="TvFocusModeToggle"
                          Grid.Row="3"
                          Grid.Column="1"
                          IsChecked="{Binding TvFocusMode, Mode=TwoWay}"
                          AutomationProperties.Name="TV focus mode enabled"
                          TabIndex="4"
                          Content="Enlarge focus targets for remote / TV navigation"/>
            </Grid>

            <Grid RowDefinitions="Auto,Auto,Auto" ColumnDefinitions="220,*" RowSpacing="14" ColumnSpacing="22">
                <TextBlock Text="Initial volume" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="14" VerticalAlignment="Center"/>
                <Grid Grid.Column="1" ColumnDefinitions="*,86" ColumnSpacing="12">
                    <Slider x:Name="InitialVolumeSlider"
                            Minimum="0"
                            Maximum="100"
                            TickFrequency="10"
                            IsSnapToTickEnabled="True"
                            AutomationProperties.Name="Initial volume"
                            TabIndex="5"
                            Value="{Binding InitialVolume, Mode=TwoWay}"/>
                    <NumericUpDown x:Name="InitialVolumeInput"
                                   Grid.Column="1"
                                   Minimum="0"
                                   Maximum="100"
                                   Increment="1"
                                   AutomationProperties.Name="Initial volume value"
                                   TabIndex="6"
                                   Value="{Binding InitialVolume, Mode=TwoWay}"/>
                </Grid>

                <TextBlock Grid.Row="1" Text="Disk image cache MB" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="14" VerticalAlignment="Center"/>
                <NumericUpDown x:Name="DiskCacheLimitInput"
                               Grid.Row="1"
                               Grid.Column="1"
                               Minimum="64"
                               Maximum="500"
                               Increment="16"
                               AutomationProperties.Name="Disk image cache limit in megabytes"
                               TabIndex="7"
                               Value="{Binding ImageDiskCacheLimitMb, Mode=TwoWay}"
                               Width="120"
                               HorizontalAlignment="Left"/>

                <TextBlock Grid.Row="2" Text="Decoded image entries" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="14" VerticalAlignment="Center"/>
                <NumericUpDown x:Name="DecodedImageLimitInput"
                               Grid.Row="2"
                               Grid.Column="1"
                               Minimum="16"
                               Maximum="512"
                               Increment="8"
                               AutomationProperties.Name="Decoded image cache entry limit"
                               TabIndex="8"
                               Value="{Binding DecodedImageMemoryItemLimit, Mode=TwoWay}"
                               Width="120"
                               HorizontalAlignment="Left"/>
            </Grid>

            <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1,0,0,0" Padding="16,0,0,0">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="18">
                    <TextBlock Text="Clear metadata and image cache" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="14" VerticalAlignment="Center"/>
                    <Button x:Name="ClearCacheButton"
                            Grid.Column="1"
                            Content="Clear cache"
                            Command="{Binding ClearCacheCommand}"
                            AutomationProperties.Name="Clear metadata and image cache"
                            TabIndex="9"
                            Padding="14,8"
                            CornerRadius="5"/>
                </Grid>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
