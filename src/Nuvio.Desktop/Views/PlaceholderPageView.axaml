<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Nuvio.Desktop.ViewModels"
             x:Class="Nuvio.Desktop.Views.PlaceholderPageView"
             x:DataType="vm:PlaceholderPageViewModel">
    <Grid Margin="26,22">
        <StackPanel Spacing="8" MaxWidth="720">
            <TextBlock Text="{Binding Title}" Foreground="#F4F7F7" FontSize="28" FontWeight="SemiBold"/>
            <TextBlock Text="{Binding Summary}" Foreground="#B8C4C5" FontSize="14" TextWrapping="Wrap"/>
        </StackPanel>
    </Grid>
</UserControl>
