<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Nuvio.Desktop.ViewModels"
             xmlns:controls="using:Nuvio.Desktop.Controls"
             x:Class="Nuvio.Desktop.Views.HomePageView"
             x:DataType="vm:HomePageViewModel">
    <Grid RowDefinitions="Auto,*" Margin="26,22">
        <Grid ColumnDefinitions="*,Auto">
            <StackPanel Spacing="4">
                <TextBlock Text="Home" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="28" FontWeight="SemiBold"/>
                <TextBlock Text="Fixture rails adapted from the mobile home flow." Foreground="{DynamicResource TextMutedBrush}" FontSize="13"/>
            </StackPanel>
            <TextBlock Grid.Column="1" Text="Fixture data" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center"/>
        </Grid>

        <Grid Grid.Row="1" Margin="0,18,0,0">
            <controls:StateOverlay IsLoading="{Binding IsLoading}"
                                   IsError="{Binding HasError}"
                                   IsEmpty="{Binding IsEmpty}"
                                   ErrorMessage="{Binding ErrorMessage}"
                                   LoadingMessage="Loading home…"
                                   EmptyMessage="No home rows available"
                                   Hint="Install and validate at least one addon before loading catalog rows on Home, and confirm your network is reachable."/>

            <ListBox x:Name="HomeSectionsList"
                     ItemsSource="{Binding Sections}"
                     Background="Transparent"
                     BorderThickness="0"
                     Padding="0">
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <VirtualizingStackPanel/>
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
                <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="vm:HomeSectionViewModel">
                        <StackPanel Spacing="10" Margin="0,0,0,20">
                            <TextBlock Text="{Binding Title}" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="18" FontWeight="SemiBold"/>
                            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                                <ItemsControl ItemsSource="{Binding Items}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal" Spacing="12"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:PosterCardViewModel">
                                            <controls:PosterCard x:Name="PosterCard"
                                                                 Classes.tv-focus="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).IsTvLayout, FallbackValue=false}"
                                                                 Title="{Binding Name}"
                                                                 Subtitle="{Binding ReleaseInfo}"
                                                                 Initial="{Binding PosterInitial}"
                                                                 Command="{Binding OpenCommand}"
                                                                 CommandParameter="{Binding Item}"
                                                                 AutomationProperties.Name="{Binding Name}"
                                                                 CardWidth="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).PosterCardWidth, FallbackValue=150}"
                                                                 CardHeight="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).PosterCardHeight, FallbackValue=252}"/>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Grid>
    </Grid>
</UserControl>
