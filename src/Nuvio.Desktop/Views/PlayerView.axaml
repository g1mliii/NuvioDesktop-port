<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Nuvio.Desktop.ViewModels"
             xmlns:controls="using:Nuvio.Desktop.Controls"
             x:Class="Nuvio.Desktop.Views.PlayerView"
             x:DataType="vm:PlayerViewModel">
    <UserControl.Styles>
        <!-- Mini-player layout (stream I): the same VideoHost is repositioned into a compact docked surface,
             keeping the single active engine instance alive while the user browses. -->
        <Style Selector="Grid.mini Border#PlayerStage">
            <Setter Property="MaxWidth" Value="440"/>
            <Setter Property="MaxHeight" Value="248"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="VerticalAlignment" Value="Bottom"/>
            <Setter Property="Margin" Value="12"/>
        </Style>
    </UserControl.Styles>

    <Grid x:Name="PlayerRoot" RowDefinitions="*,Auto" Background="{DynamicResource PlayerBackgroundBrush}"
          Classes.mini="{Binding IsMiniMode}">
        <Grid Margin="28">
            <Border x:Name="PlayerStage" Background="{DynamicResource PlayerStageBrush}" BorderBrush="{DynamicResource BorderStrongBrush}" BorderThickness="1" CornerRadius="8" ClipToBounds="True">
                <Grid Margin="22">
                    <controls:LibMpvVideoView x:Name="VideoHost"
                                              Engine="{Binding VideoSource}"
                                              IsVisible="{Binding VideoSource, Converter={x:Static ObjectConverters.IsNotNull}}"
                                              Margin="-22"/>
                    <StackPanel x:Name="PlaybackPlaceholder"
                                IsVisible="{Binding VideoSource, Converter={x:Static ObjectConverters.IsNull}}"
                                Spacing="10"
                                VerticalAlignment="Center"
                                HorizontalAlignment="Center">
                        <TextBlock Text="{Binding Title}" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="30" FontWeight="SemiBold" TextAlignment="Center"/>
                        <TextBlock Text="{Binding StreamTitle}" Foreground="{DynamicResource AccentBrush}" FontSize="15" TextAlignment="Center"/>
                        <TextBlock Text="{Binding Status}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="13" TextAlignment="Center" TextWrapping="Wrap"/>
                        <TextBlock Text="{Binding ErrorMessage}" IsVisible="{Binding HasError}" Foreground="{DynamicResource ErrorBrush}" TextAlignment="Center" TextWrapping="Wrap" MaxWidth="680"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <controls:PlayerControls Grid.Row="1"/>
    </Grid>
</UserControl>
