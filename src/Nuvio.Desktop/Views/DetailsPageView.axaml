<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Nuvio.Desktop.ViewModels"
             x:Class="Nuvio.Desktop.Views.DetailsPageView"
             x:DataType="vm:DetailsPageViewModel">
    <ScrollViewer Padding="26,22">
        <StackPanel Spacing="18">
            <TextBlock Text="Loading details..." IsVisible="{Binding IsLoading}" Foreground="#9BD5D1"/>
            <TextBlock Text="{Binding ErrorMessage}" IsVisible="{Binding HasError}" Foreground="#FFB4A6" TextWrapping="Wrap"/>

            <StackPanel Spacing="16" IsVisible="{Binding HasDetails}">
                <Border Height="168" Background="#1E2B31" CornerRadius="7" ToolTip.Tip="{Binding BackdropUrl}">
                    <Grid Margin="18">
                        <TextBlock Text="{Binding Title}" Foreground="#F4F7F7" FontSize="28" FontWeight="SemiBold" TextWrapping="Wrap" VerticalAlignment="Bottom"/>
                    </Grid>
                </Border>

                <Grid ColumnDefinitions="180,*" ColumnSpacing="22">
                    <Border Width="180" Height="264" Background="#26363B" CornerRadius="7" ToolTip.Tip="{Binding PosterUrl}">
                        <TextBlock Text="{Binding PosterInitial}" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#9BD5D1" FontSize="54" FontWeight="SemiBold"/>
                    </Border>
                    <StackPanel Grid.Column="1" Spacing="10">
                        <TextBlock Text="{Binding Title}" Foreground="#F4F7F7" FontSize="32" FontWeight="SemiBold" TextWrapping="Wrap"/>
                        <TextBlock Text="{Binding ReleaseLine}" Foreground="#B8C4C5" FontSize="14"/>
                        <TextBlock Text="{Binding GenreLine}" Foreground="#9BD5D1" FontSize="13"/>
                        <TextBlock Text="{Binding Description}" Foreground="#C8D0D1" FontSize="14" TextWrapping="Wrap" MaxWidth="720"/>
                    </StackPanel>
                </Grid>
            </StackPanel>

            <TextBlock Text="No playable streams are available for this fixture." IsVisible="{Binding HasNoStreams}" Foreground="#98A5A8"/>

            <StackPanel Spacing="10" IsVisible="{Binding HasStreams}">
                <TextBlock Text="Streams" Foreground="#F1F4F4" FontSize="18" FontWeight="SemiBold"/>
                <ItemsControl x:Name="StreamRows" ItemsSource="{Binding Streams}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:StreamRowViewModel">
                            <Border Background="#182024" BorderBrush="#2C3940" BorderThickness="1" CornerRadius="7" Padding="12" Margin="0,0,0,10">
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                    <StackPanel Spacing="3">
                                        <TextBlock Text="{Binding Title}" Foreground="#F2F5F5" FontSize="15" FontWeight="SemiBold"/>
                                        <TextBlock Text="{Binding QualityLabel}" Foreground="#9BD5D1" FontSize="12"/>
                                        <TextBlock Text="{Binding Description}" Foreground="#98A5A8" FontSize="12" TextWrapping="Wrap"/>
                                    </StackPanel>
                                    <Button Grid.Column="1" Content="Play" Command="{Binding PlayCommand}" Padding="16,7" CornerRadius="5"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
