<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Nuvio.Desktop.ViewModels"
             xmlns:controls="using:Nuvio.Desktop.Controls"
             x:Class="Nuvio.Desktop.Views.SearchPageView"
             x:DataType="vm:SearchPageViewModel">
    <Grid RowDefinitions="Auto,*" Margin="26,22">
        <StackPanel Spacing="10">
            <TextBlock Text="Search" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="28" FontWeight="SemiBold"/>
            <TextBox x:Name="SearchBox"
                     Text="{Binding SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                     PlaceholderText="Search fixture catalog"
                     AutomationProperties.Name="Search query"
                     TabIndex="0"
                     MinHeight="38"/>
            <TextBlock Text="{Binding ResultCount, StringFormat={}{0} results}" Foreground="{DynamicResource TextMutedBrush}" FontSize="13"/>
        </StackPanel>

        <Grid Grid.Row="1" Margin="0,18,0,0">
            <controls:StateOverlay IsLoading="{Binding IsLoading}"
                                   IsError="{Binding HasError}"
                                   IsEmpty="{Binding IsEmpty}"
                                   ErrorMessage="{Binding ErrorMessage}"
                                   LoadingMessage="Searching…"
                                   EmptyMessage="No titles found"
                                   Hint="No results matched that query. Search depends on installed catalog addons — install or enable one, and verify your network connection."/>

            <ListBox x:Name="SearchRowsList"
                     ItemsSource="{Binding Rows}"
                     Background="Transparent"
                     BorderThickness="0"
                     Padding="0">
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <VirtualizingStackPanel/>
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
                <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="vm:PosterGridRowViewModel">
                        <ItemsControl ItemsSource="{Binding Items}" Margin="0,0,0,14">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" Spacing="14"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:PosterCardViewModel">
                                    <controls:PosterCard x:Name="PosterCard"
                                                         Classes.tv-focus="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).IsTvLayout, FallbackValue=false}"
                                                         Title="{Binding Name}"
                                                         Subtitle="{Binding ReleaseInfo}"
                                                         Initial="{Binding PosterInitial}"
                                                         Command="{Binding OpenCommand}"
                                                         CommandParameter="{Binding Item}"
                                                         AutomationProperties.Name="{Binding Name}"
                                                         CardWidth="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).PosterCardWidth, FallbackValue=150}"
                                                         CardHeight="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).PosterCardHeight, FallbackValue=252}"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Grid>
    </Grid>
</UserControl>
