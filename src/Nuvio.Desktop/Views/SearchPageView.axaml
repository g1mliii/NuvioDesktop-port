<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Nuvio.Desktop.ViewModels"
             x:Class="Nuvio.Desktop.Views.SearchPageView"
             x:DataType="vm:SearchPageViewModel">
    <Grid RowDefinitions="Auto,*" Margin="26,22">
        <StackPanel Spacing="10">
            <TextBlock Text="Search" Foreground="#F4F7F7" FontSize="28" FontWeight="SemiBold"/>
            <TextBox x:Name="SearchBox"
                     Text="{Binding SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                     PlaceholderText="Search fixture catalog"
                     MinHeight="38"/>
            <TextBlock Text="{Binding ResultCount, StringFormat={}{0} results}" Foreground="#98A5A8" FontSize="13"/>
        </StackPanel>

        <Grid Grid.Row="1" Margin="0,18,0,0">
            <TextBlock Text="Searching..." IsVisible="{Binding IsLoading}" Foreground="#9BD5D1"/>
            <TextBlock Text="{Binding ErrorMessage}" IsVisible="{Binding HasError}" Foreground="#FFB4A6" TextWrapping="Wrap"/>
            <TextBlock Text="No fixture results matched that query." IsVisible="{Binding IsEmpty}" Foreground="#98A5A8"/>

            <ListBox x:Name="SearchRowsList"
                     ItemsSource="{Binding Rows}"
                     Background="Transparent"
                     BorderThickness="0"
                     Padding="0">
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <VirtualizingStackPanel/>
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
                <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="vm:PosterGridRowViewModel">
                        <ItemsControl ItemsSource="{Binding Items}" Margin="0,0,0,14">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" Spacing="14"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:PosterCardViewModel">
                                    <Button x:Name="PosterCard"
                                            Width="150"
                                            Height="252"
                                            Padding="0"
                                            CornerRadius="7"
                                            Command="{Binding OpenCommand}"
                                            CommandParameter="{Binding Item}"
                                            Background="#182024"
                                            BorderBrush="#2C3940"
                                            BorderThickness="1">
                                        <Grid RowDefinitions="214,*">
                                            <Border Width="148" Height="214" Background="#26363B" CornerRadius="7,7,0,0">
                                                <TextBlock Text="{Binding PosterInitial}" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#9BD5D1" FontSize="46" FontWeight="SemiBold"/>
                                            </Border>
                                            <Border Grid.Row="1" Padding="8,7">
                                                <StackPanel Spacing="2">
                                                    <TextBlock Text="{Binding Name}" Foreground="#F2F5F5" FontSize="12" FontWeight="SemiBold" TextWrapping="Wrap" MaxHeight="34"/>
                                                    <TextBlock Text="{Binding ReleaseInfo}" Foreground="#8E9A9E" FontSize="11"/>
                                                </StackPanel>
                                            </Border>
                                        </Grid>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Grid>
    </Grid>
</UserControl>
