<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Nuvio.Desktop.ViewModels"
             xmlns:controls="using:Nuvio.Desktop.Controls"
             x:Class="Nuvio.Desktop.Views.CatalogPageView"
             x:DataType="vm:CatalogPageViewModel">
    <Grid RowDefinitions="Auto,*" Margin="26,22">
        <Grid ColumnDefinitions="*,Auto">
            <StackPanel Spacing="4">
                <TextBlock Text="Catalog" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="28" FontWeight="SemiBold"/>
                <TextBlock Text="{Binding ItemCount, StringFormat={}{0} fixture titles}" Foreground="{DynamicResource TextMutedBrush}" FontSize="13"/>
            </StackPanel>
            <TextBlock Grid.Column="1" Text="Virtualized rows" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center"/>
        </Grid>

        <Grid Grid.Row="1" Margin="0,18,0,0">
            <controls:StateOverlay IsLoading="{Binding IsLoading}"
                                   IsError="{Binding HasError}"
                                   IsEmpty="{Binding IsEmpty}"
                                   ErrorMessage="{Binding ErrorMessage}"
                                   LoadingMessage="Loading catalog…"
                                   EmptyMessage="No titles found"
                                   Hint="This catalog did not return any items. Install a catalog addon and confirm it is enabled; if it is, the addon endpoint may be unreachable — check your network."/>

            <ListBox x:Name="CatalogRowsList"
                     ItemsSource="{Binding Rows}"
                     Background="Transparent"
                     BorderThickness="0"
                     Padding="0">
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <VirtualizingStackPanel/>
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
                <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="vm:PosterGridRowViewModel">
                        <ItemsControl ItemsSource="{Binding Items}" Margin="0,0,0,14">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" Spacing="14"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:PosterCardViewModel">
                                    <controls:PosterCard x:Name="PosterCard"
                                                         Classes.tv-focus="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).IsTvLayout, FallbackValue=false}"
                                                         Title="{Binding Name}"
                                                         Subtitle="{Binding ReleaseInfo}"
                                                         Initial="{Binding PosterInitial}"
                                                         Command="{Binding OpenCommand}"
                                                         CommandParameter="{Binding Item}"
                                                         AutomationProperties.Name="{Binding Name}"
                                                         CardWidth="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).PosterCardWidth, FallbackValue=150}"
                                                         CardHeight="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).PosterCardHeight, FallbackValue=252}"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Grid>
    </Grid>
</UserControl>
