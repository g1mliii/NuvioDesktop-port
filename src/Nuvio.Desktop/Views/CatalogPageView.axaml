<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Nuvio.Desktop.ViewModels"
             x:Class="Nuvio.Desktop.Views.CatalogPageView"
             x:DataType="vm:CatalogPageViewModel">
    <Grid RowDefinitions="Auto,*" Margin="26,22">
        <Grid ColumnDefinitions="*,Auto">
            <StackPanel Spacing="4">
                <TextBlock Text="Catalog" Foreground="#F4F7F7" FontSize="28" FontWeight="SemiBold"/>
                <TextBlock Text="{Binding ItemCount, StringFormat={}{0} fixture titles}" Foreground="#98A5A8" FontSize="13"/>
            </StackPanel>
            <TextBlock Grid.Column="1" Text="Virtualized rows" Foreground="#9BD5D1" VerticalAlignment="Center"/>
        </Grid>

        <Grid Grid.Row="1" Margin="0,18,0,0">
            <TextBlock Text="Loading catalog..." IsVisible="{Binding IsLoading}" Foreground="#9BD5D1"/>
            <TextBlock Text="{Binding ErrorMessage}" IsVisible="{Binding HasError}" Foreground="#FFB4A6" TextWrapping="Wrap"/>
            <TextBlock Text="No catalog items are available." IsVisible="{Binding IsEmpty}" Foreground="#98A5A8"/>

            <ListBox x:Name="CatalogRowsList"
                     ItemsSource="{Binding Rows}"
                     Background="Transparent"
                     BorderThickness="0"
                     Padding="0">
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <VirtualizingStackPanel/>
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
                <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="vm:PosterGridRowViewModel">
                        <ItemsControl ItemsSource="{Binding Items}" Margin="0,0,0,14">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" Spacing="14"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:PosterCardViewModel">
                                    <Button x:Name="PosterCard"
                                            Width="150"
                                            Height="252"
                                            Padding="0"
                                            CornerRadius="7"
                                            Command="{Binding OpenCommand}"
                                            CommandParameter="{Binding Item}"
                                            Background="#182024"
                                            BorderBrush="#2C3940"
                                            BorderThickness="1">
                                        <Grid RowDefinitions="214,*">
                                            <Border Width="148" Height="214" Background="#26363B" CornerRadius="7,7,0,0">
                                                <TextBlock Text="{Binding PosterInitial}" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#9BD5D1" FontSize="46" FontWeight="SemiBold"/>
                                            </Border>
                                            <Border Grid.Row="1" Padding="8,7">
                                                <StackPanel Spacing="2">
                                                    <TextBlock Text="{Binding Name}" Foreground="#F2F5F5" FontSize="12" FontWeight="SemiBold" TextWrapping="Wrap" MaxHeight="34"/>
                                                    <TextBlock Text="{Binding ReleaseInfo}" Foreground="#8E9A9E" FontSize="11"/>
                                                </StackPanel>
                                            </Border>
                                        </Grid>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Grid>
    </Grid>
</UserControl>
